# Copy to .env.local and fill in. Never commit .env.local.
#
# DATABASE_URL / TEST_DATABASE_URL — postgresql://user:pass@host:port/database
#   docker-compose.yml serves both on localhost:5432 as postgres/postgres.
# BETTER_AUTH_SECRET — openssl rand -base64 32
#   Rotating it invalidates every existing session, so set it once.
# PICKUP_CODE_PEPPER — openssl rand -base64 32
#   Peppers the pickup code hashes. Six digits is a million candidates, so a
#   bare digest column would be brute-forced; the pepper is what keeps a
#   database read from opening every locker. Rotating it invalidates every
#   pickup code already issued.

DATABASE_URL=
TEST_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
PICKUP_CODE_PEPPER=
