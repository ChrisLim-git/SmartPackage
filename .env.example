# Copy to .env.local and fill in. Never commit .env.local.
#
# DATABASE_URL / TEST_DATABASE_URL — postgresql://user:pass@host:port/database
#   docker-compose.yml serves both on localhost:5432 as postgres/postgres.
# BETTER_AUTH_SECRET — openssl rand -base64 32
#   Rotating it invalidates every existing session, so set it once.

DATABASE_URL=
TEST_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# NEXT_PUBLIC_DEMO_MODE — "true" keeps the sign-in role picker and the collect
#   page's test-parcel panel on in a production build. Leave unset locally: both
#   are already on outside production. Never set it on a real deployment.
NEXT_PUBLIC_DEMO_MODE=
