# Copy to .env.local and fill in. Never commit .env.local.

# Application database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartpackage

# Integration tests run against their own database, never the app's.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartpackage_test

# Session signing key. Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session, so set it once.
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
