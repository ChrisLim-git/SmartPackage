{
  "version": "0.2.0",
  "configurations": [
    {
      // The default F5 target: server + browser in one action.
      "name": "Next.js: full stack",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      // Route handlers and use cases.
      "name": "Next.js: server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev --inspect"
    },
    {
      "name": "Next.js: client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      // `--runInBand` is mandatory: Jest workers break the inspector, and
      // breakpoints silently never bind without it. The NODE_OPTIONS flag has to
      // match the test scripts or debugging fails where running succeeds.
      "name": "Jest: current file",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-vm-modules",
        "--inspect-brk",
        "${workspaceRoot}/node_modules/.bin/jest",
        "--runInBand",
        "--runTestsByPath",
        "${relativeFile}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Jest: all tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--experimental-vm-modules",
        "--inspect-brk",
        "${workspaceRoot}/node_modules/.bin/jest",
        "--runInBand"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      // 9230, not 9229. `next dev` forks a child for app code and increments the
      // debug port, so the parent keeps 9229. Attaching to 9229 connects to the
      // wrong target and binds no breakpoints, with no error to tell you.
      "name": "Attach to running dev server (port 9230)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
